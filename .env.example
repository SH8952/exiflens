# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored and never committed.

# Production domain, used for canonical URLs / hreflang / Open Graph / JSON-LD.
# Falls back to a placeholder (https://exiflens.com) until you set this.
NEXT_PUBLIC_SITE_URL=

# Google AdSense publisher ID (from your AdSense account, starts with "pub-")
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Coupang Partners Open API credentials (Coupang Partners dashboard > Open API)
# Server-only — never expose these with a NEXT_PUBLIC_ prefix.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# The subId/tracking code attached to your Coupang Partners links
COUPANG_PARTNER_SUBID=

# AliExpress Affiliate Open Platform credentials (openservice.aliexpress.com > My Apps).
# Shown for every non-Korea visitor (see src/lib/affiliate.ts).
# Server-only — never expose these with a NEXT_PUBLIC_ prefix.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Tracking ID created in AliExpress Portals (portals.aliexpress.com > Account > Tracking Id)
ALIEXPRESS_TRACKING_ID=

# Vercel KV (Upstash Redis) — shared instance connected to ExifLens/
# FlyDroneMap/firelic together (Vercel dashboard > Storage > Connect
# Project). Auto-populated once the project is connected; no manual value
# needed here.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret token that lets the developer exclude their own visits (from any
# network/device) from the visitor counter and Google Analytics. Visiting
# https://<domain>/?dev=<this value> once per browser/device sets a
# long-lived cookie. Keep this out of git — set the real value only in
# .env.local and in each Vercel project's Environment Variables.
DEV_EXCLUDE_TOKEN=
