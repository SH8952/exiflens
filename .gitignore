# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local backups (작업 전 자동 백업 폴더, git에는 포함하지 않음)
/_backups

# 1회용 push 스크립트 (실행 완료 후 자동 삭제되지만, 혹시 남아있어도 커밋되지 않도록)
*Push.command

# 내부 기획 문서 (공개 저장소에 올라가면 안 됨)
/기획안
__pycache__/

# 빌드 정리 단계에서 EPERM으로 인해 .next 대신 이름을 바꿔 남겨진 임시 폴더
.next.stale.*/
